# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional — enables admin API fallbacks
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App
NEXT_PUBLIC_APP_NAME=UNSTOPPABLE TEAM
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Africa/Lagos

# OCR.space sheet import (required for screenshot upload)
# Register free at https://ocr.space/ocrapi
OCR_SPACE_API_KEY=your_ocr_space_api_key_here
# Optional — 3 = best for handwriting (default), 2 = printed text
# OCR_SPACE_ENGINE=3

# Keep-alive cron (optional but recommended on free Supabase)
# Vercel Cron calls /api/keep-alive daily so the project does not pause.
# If set, requests must send Authorization: Bearer <secret>
# CRON_SECRET=generate_a_long_random_string
